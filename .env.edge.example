# ============================================================
# 선박 인트라(엣지) 서버 설정 템플릿
# 신규 선박 설치 시 이 파일을 .env 로 복사하고 아래 값만 수동 기입.
# ============================================================

# ── ① 선박 고유 코드 (중앙에 등록된 vessel_no) ──
VESSEL=DSRJ2

# ── ② 로컬 접속 (선내 LAN) ──
# 서버의 고정 IP(OS에서 설정) + 아래 포트로 승조원이 접속.
# 예) http://192.168.10.5:30001
PORT=30001

# ── ③ 중앙 서버 (회사에 따라 택1) ──
#   toads      → https://pms.toads.kr
#   youngchang → https://ycpms.toads.kr
REMOTE_SITE_URL=https://pms.toads.kr
# 중앙 인증 토큰 (온보딩 시 중앙에서 발급받아 기입)
NODE_TOKEN=

# ── ④ 로컬 PostgreSQL 접속 (수동 설치한 PG) ──
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=toadsdocument
DB_USER=postgres
DB_PASS=
DB_SSL=false

# ── 이하 고정값 (수정 불필요) ──
NODE_ROLE=edge
# 기동 시 자동 온보딩 + 회선 감지 자동 동기화
SYNC_WATCHER=on
SYNC_POLL_MS=15000
SYNC_PROBE_TIMEOUT_MS=3000
